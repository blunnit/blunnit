# ═══════════════════════════════════════════
# BLUNNIT Environment Variables
# Copy this file to .env.local and fill in
# ═══════════════════════════════════════════

# Supabase (get from supabase.com > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic (get from console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Stripe (get from dashboard.stripe.com > Developers > API Keys)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PRICE_ID=your_stripe_price_id

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
